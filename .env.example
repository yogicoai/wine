# ── Bottle Lens 환경변수 ──────────────────────────────
# 값 채운 뒤 .env.local 로 복사해서 사용하세요. (.env.local 은 git 제외됨)

# Anthropic API 키 (없으면 데모 모드로 동작 — 샘플 결과 순환)
ANTHROPIC_API_KEY=

# 분석 모델: claude-sonnet-5(권장·기본) | claude-opus-4-8(정밀) | claude-haiku-4-5(저비용)
CLAUDE_MODEL=claude-sonnet-5

# 라벨 1차 판독 모델 — 사진에서 제품명만 뽑아 카탈로그를 먼저 조회한다.
# 카탈로그에 있으면 본 분석을 건너뛰므로 스캔 원가가 63원 → 수 원으로 떨어진다.
IDENTIFY_MODEL=claude-haiku-4-5
# 1차 판독 끄기: PRESCAN=0 (끄면 사진 스캔은 항상 본 분석을 수행)
PRESCAN=1

# 웹 검색 보강 (1=모든 스캔에 항상 ON, 0=OFF ← 권장)
# 실측: 검색 ON이면 스캔당 316원·179초, OFF면 45원·30초 (비용 7배 차이)
# 가격은 무료인 네이버쇼핑 조회가 담당하므로 중복 → OFF 권장
WEB_SEARCH=0

# "최신 정보 더 찾기" 버튼 (건별 웹 검색)
# 0 = 버튼 숨김 + 서버에서도 차단 (기본·권장)
# 1 = 사용. 단 3분이 걸려 Vercel 무료 플랜(60초)에서는 타임아웃되므로 Pro 필요
DEEP_SEARCH=0
NEXT_PUBLIC_DEEP_SEARCH=0

# MongoDB
MONGODB_URI=
MONGODB_DB=winelens

# 네이버쇼핑 검색 API (실제 제품 이미지·최저가·구매 링크 노출용)
# developers.naver.com → 애플리케이션 등록 → "검색" API 선택 → Client ID/Secret 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Cafe24(오픈호스팅) 이미지 업로드 — 썸네일을 DB 대신 웹호스팅에 저장
# 미설정 시 자동으로 base64 저장으로 폴백하므로 없어도 동작합니다.
YOGIBO_FTP=
YOGIBO_FTP_ID=
YOGIBO_FTP_PW=
YOGIBO_FPT_LINK=/app/img/wine/
FTP_PUBLIC_BASE=
