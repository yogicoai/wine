# ── Bottle Lens 환경변수 ──────────────────────────────
# 값 채운 뒤 .env.local 로 복사해서 사용하세요. (.env.local 은 git 제외됨)

# Anthropic API 키 (없으면 데모 모드로 동작 — 샘플 결과 순환)
ANTHROPIC_API_KEY=

# 분석 모델: claude-sonnet-5(권장·기본) | claude-opus-4-8(정밀) | claude-haiku-4-5(저비용)
CLAUDE_MODEL=claude-sonnet-5

# 라벨 1차 판독 모델 — 사진에서 제품명만 뽑아 카탈로그를 먼저 조회한다.
# 카탈로그에 있으면 본 분석을 건너뛰므로 스캔 원가가 63원 → 수 원으로 떨어진다.
IDENTIFY_MODEL=claude-haiku-4-5
# 1차 판독 끄기: PRESCAN=0 (끄면 사진 스캔은 항상 본 분석을 수행)
PRESCAN=1

# 웹 검색 보강 (1=모든 스캔에 항상 ON, 0=OFF ← 권장)
# 실측: 검색 ON이면 스캔당 316원·179초, OFF면 45원·30초 (비용 7배 차이)
# 가격은 무료인 네이버쇼핑 조회가 담당하므로 중복 → OFF 권장
WEB_SEARCH=0

# "최신 정보 더 찾기" 버튼 (건별 웹 검색)
# 0 = 버튼 숨김 + 서버에서도 차단 (기본·권장)
# 1 = 사용. 단 3분이 걸려 Vercel 무료 플랜(60초)에서는 타임아웃되므로 Pro 필요
DEEP_SEARCH=0
NEXT_PUBLIC_DEEP_SEARCH=0

# 특가 푸시 알림 (앱을 닫아 두어도 알림 수신)
# 키 생성: node -e "console.log(require('web-push').generateVAPIDKeys())"
# 비워 두면 알림 기능이 화면에 나타나지 않습니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com

# 정기 가격 점검(Vercel Cron) 보호용 — 아무 문자열이나 정하면 됩니다.
# Vercel이 Authorization: Bearer <값> 으로 호출합니다.
CRON_SECRET=

# MongoDB
MONGODB_URI=
MONGODB_DB=winelens

# 네이버쇼핑 검색 API (실제 제품 이미지·최저가·구매 링크 노출용)
# developers.naver.com → 애플리케이션 등록 → "검색" API 선택 → Client ID/Secret 발급
# ── 검색 API 발급처 ─────────────────────────────────────
# 개발자센터(아래 NAVER_CLIENT_*)는 2027-06-30 에 지원이 끝난다.
# 그 전에 NAVER API HUB(네이버 클라우드 플랫폼)에서 키를 받아 아래에 넣으면
# 코드 수정 없이 그쪽으로 넘어간다. 요금은 같다 (월 775,000건 무료, 일 25,000건).
#   확인: /api/naver/ping  → 지금 어느 발급처로 나가는지 보여 준다
NAVER_APIHUB_KEY_ID=
NAVER_APIHUB_KEY=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 11번가 오픈 API — 실제 판매가·상품 사진
#
# 네이버 쇼핑 검색 API는 2026-07-31 에 종료됐다(네이버 공식). 되살릴 방법이 없어
# 그 자리를 11번가로 메운다. 판매자 계정이 아니어도 무료로 받을 수 있다.
#   https://openapi.11st.co.kr → 로그인 → [서비스 등록·확인] → 32자리 Key
#
# 없어도 앱은 돈다 — 그때는 우리가 조사해 둔 시세(priceInfo)만 보여 준다.
# 넣으면 실제 판매가와 상품 사진이 함께 붙는다.
#   사진 일괄 채우기: node scripts/_fill-images-11st.mjs all 300
ELEVENST_KEY=

# Cafe24(오픈호스팅) 이미지 업로드 — 썸네일을 DB 대신 웹호스팅에 저장
# 미설정 시 자동으로 base64 저장으로 폴백하므로 없어도 동작합니다.
YOGIBO_FTP=
YOGIBO_FTP_ID=
YOGIBO_FTP_PW=
YOGIBO_FPT_LINK=/app/img/wine/
FTP_PUBLIC_BASE=
